{
  "name": "dsh-maid-vcp",
  "version": "0.6.14",
  "description": "DSH 小困插件 · VCP 视觉通感协议：消息 HTML 渲染开关 + vcp-fast 缓存/增量加速渲染引擎 + 内置 7 款开源精选字体 + 设计规范注入（任何电脑/agent 即插即用）",
  "icon": "assets/plugin-icon.png",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "vcp",
    "visual-synesthesia",
    "html",
    "rendering"
  ],
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "install-patch": "node patch/install-all.cjs",
    "install-patch:dry": "node patch/install-all.cjs --dry-run",
    "test": "node patch/check-anchors.cjs && node tests/bundle.test.mjs && node tests/boost-fontface.test.cjs",
    "test:dom": "node tests/smoke.test.mjs && node tests/stable.test.mjs && node tests/trusted.test.mjs && node tests/security.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "assets",
    "patch/*.js",
    "patch/*.cjs",
    "tools/*.cjs",
    "tools/*.py",
    "tests/*.mjs",
    "tests/*.cjs",
    "docs",
    "cordis.patch.yml",
    "DESIGN.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "VCP-INTERACTIONS.md",
    "FRAMING.md",
    "EDITORIAL.md",
    "BREATH.md",
    "styles",
    "examples",
    "fonts-index.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "react",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.3.1"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "puppeteer": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Valorine97417/dsh-maid-vcp.git"
  },
  "homepage": "https://github.com/Valorine97417/dsh-maid-vcp",
  "bugs": {
    "url": "https://github.com/Valorine97417/dsh-maid-vcp/issues"
  }
}
